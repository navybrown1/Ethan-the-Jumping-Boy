{
  "name": "ethan-the-jumping-boy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npm run lint && npm run test:logic",
    "test:logic": "tsx --test test/logic.test.ts",
    "test:e2e": "node test/e2e/run.mjs",
    "test:smoke": "node test/e2e/run.mjs --only=prod",
    "test:subpath": "node test/e2e/subpath.mjs",
    "test:arena": "node test/e2e/arena-runway.mjs",
    "test:boss": "node test/e2e/boss-nopowers.mjs",
    "test:perf": "node test/e2e/performance.mjs",
    "test:touch": "node test/e2e/touch-input.mjs",
    "test:audio": "node test/e2e/audio.mjs",
    "test:traverse": "node test/e2e/traversal.mjs",
    "test:flash": "node test/e2e/photosensitivity.mjs",
    "test:xbrowser": "node test/e2e/cross-browser.mjs",
    "test:xbrowser:all": "node test/e2e/cross-browser.mjs --all"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
